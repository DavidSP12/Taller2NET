{
  "Jwt": {
    "Key": "Taller2NET_SuperSecretKey_AtLeast32Chars!",
    "Issuer": "Taller2NET",
    "Audience": "Taller2NET-Client"
  },
  "ReverseProxy": {
    "Routes": {
      "academic-auth-route": {
        "ClusterId": "academic-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "academic-students-route": {
        "ClusterId": "academic-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/students/{**catch-all}"
        }
      },
      "academic-courses-route": {
        "ClusterId": "academic-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/courses/{**catch-all}"
        }
      },
      "academic-enrollments-route": {
        "ClusterId": "academic-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/enrollments/{**catch-all}"
        }
      },
      "academic-attendances-route": {
        "ClusterId": "academic-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/attendances/{**catch-all}"
        }
      },
      "academic-grades-route": {
        "ClusterId": "academic-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/grades/{**catch-all}"
        }
      },
      "academic-health-route": {
        "ClusterId": "academic-cluster",
        "Match": {
          "Path": "/academic/health"
        },
        "Transforms": [
          { "PathRemovePrefix": "/academic" }
        ]
      },
      "academic-swagger-route": {
        "ClusterId": "academic-cluster",
        "Match": {
          "Path": "/academic/swagger/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/academic" }
        ]
      },
      "statistics-dashboard-route": {
        "ClusterId": "statistics-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/dashboard/{**catch-all}"
        }
      },
      "statistics-health-route": {
        "ClusterId": "statistics-cluster",
        "Match": {
          "Path": "/statistics/health"
        },
        "Transforms": [
          { "PathRemovePrefix": "/statistics" }
        ]
      },
      "statistics-swagger-route": {
        "ClusterId": "statistics-cluster",
        "Match": {
          "Path": "/statistics/swagger/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/statistics" }
        ]
      }
    },
    "Clusters": {
      "academic-cluster": {
        "Destinations": {
          "academic-service": {
            "Address": "http://academic-service:8080"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        }
      },
      "statistics-cluster": {
        "Destinations": {
          "statistics-service": {
            "Address": "http://statistics-service:8081"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        }
      }
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Yarp": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://+:80"
}
